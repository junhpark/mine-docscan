# 환경변수로 설정할 때의 예시. 실제 값은 .env 에 두고 커밋하지 않는다.
MINEDOCSCAN_ARCHIVE_ROOT=/path/to/mine-docscan
MINEDOCSCAN_SITE=/path/to/mine-docscan/site-packs/my-site
MINEDOCSCAN_WORK_ROOT=/path/to/local/minedocscan-work
